@model IEnumerable<ClinicaOdontologicaModelos.Cita>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FechaCita)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Motivo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EstadoCita)
            </th>
          
            <th>
                Paciente
            </th>
            <th>
				Odontologo
            </th>
            <th>
				Consultorio
            </th>
           <!----<th>
                @Html.DisplayNameFor(model => model.DetallesCita)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Recetas)
            </th>-->
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.FechaCita)
            </td>
            <td>
                @Html.DisplayFor(model => item.Motivo)
            </td>
            <td>
                @Html.DisplayFor(model => item.EstadoCita)
            </td>
           
            <td>
					@Html.DisplayFor(model => item.paciente.Nombres) @Html.DisplayFor(model => item.paciente.Apellidos)
            </td>
            <td>
                @Html.DisplayFor(model => item.odontologo.Nombres) @Html.DisplayFor(model => item.odontologo.Apellidos)
            </td>
            <td>
					@Html.DisplayFor(model => item.consultorio.NumeroSala) 
            </td>
            <!--<td>
                @Html.DisplayFor(model => item.DetallesCita)
            </td>
            <td>
                @Html.DisplayFor(model => item.Recetas)
            </td>-->
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdCita">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdCita">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdCita">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
