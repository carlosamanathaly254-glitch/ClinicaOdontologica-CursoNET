@model ClinicaOdontologicaModelos.Cita

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Cita</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FechaCita)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FechaCita)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Motivo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Motivo)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.EstadoCita)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.EstadoCita)
        </dd>
    <!--</dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IdPaciente)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IdPaciente)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IdOdontologo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IdOdontologo)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IdConsultorio)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IdConsultorio)
        </dd>-->
    </dl>
        <dt class = "col-sm-2">
	        Paciente
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.paciente.Nombres) @Html.DisplayFor(model => model.paciente.Apellidos)
        </dd>
    </dl>
        <dt class = "col-sm-2">
	        Odontologo
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.odontologo.Nombres) @Html.DisplayFor(model => model.odontologo.Apellidos)
        </dd>
    </dl>
        <dt class = "col-sm-2">
	        Consultorio
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.consultorio.NumeroSala)
        </dd>
    </dl>
        <dt class = "col-sm-2">
	        DetallesCita
        </dt>
        <dd class = "col-sm-10">
    @if (Model.DetallesCita != null && Model.DetallesCita.Any())
    {
        <div class="list-group">
            @foreach (var detalle in Model.DetallesCita)
            {
                <div class="list-group-item mb-2 border rounded p-3 bg-light">
                    <p class="mb-1"><strong>Costo:</strong> @detalle.CostoAplicado</p>
                    <p class="mb-0"><strong>Observaciones:</strong> @detalle.Observaciones</p>
                </div>
            }
        </div>
    }
    else
    {
        <span>Sin detalles registrados</span>
    }
    </dd>
    </dl>
        <dt class = "col-sm-2">
	Recetas
        </dt>
<dd class="col-sm-10">
    @if (Model.Recetas != null && Model.Recetas.Any())
    {
        <div class="list-group">
            @foreach (var receta in Model.Recetas)
            {
                <div class="list-group-item mb-2 border rounded p-3 bg-light">
                    <p class="mb-1"><strong>Indicaciones:</strong> @receta.Indicaciones</p>
                </div>
            }
        </div>
    }
    else
    {
        <span>Sin recetas registradas</span>
    }
</dd>
</dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.IdCita">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
