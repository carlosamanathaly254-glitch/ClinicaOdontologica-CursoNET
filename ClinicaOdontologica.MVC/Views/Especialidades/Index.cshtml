@model IEnumerable<ClinicaOdontologicaModelos.Especialidad>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NombreEspecialidad)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Descripcion)
            </th>
            <th>
				Odontólogos
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.NombreEspecialidad)
            </td>
            <td>
                @Html.DisplayFor(model => item.Descripcion)
            </td>
            <td>
                    @if (item.Odontologos != null && item.Odontologos.Any())
                    {
                        <ul>
                            @foreach (var odontologo in item.Odontologos)
                            {
                                <li>@odontologo.Nombres @odontologo.Apellidos</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span class="text-muted">Sin odontólogos</span>
                    }
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdEspecialidad">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdEspecialidad">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdEspecialidad">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
