@model ClinicaOdontologicaModelos.Consultorio

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Consultorio</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.NumeroSala)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NumeroSala)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Piso)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Piso)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.EquipamientoPrincipal)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.EquipamientoPrincipal)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            Citas
        </dt>
        <dd class = "col-sm-10">
    @if (Model.Citas != null && Model.Citas.Any())
    {
        <div class="list-group">
            @foreach (var cita in Model.Citas)
            {
                <div class="list-group-item mb-2 border rounded p-3 bg-light">
                    <p class="mb-1"><strong>Fecha:</strong> @cita.FechaCita</p>
                    <p class="mb-1"><strong>Motivo:</strong> @cita.Motivo</p>
                    <p class="mb-0"><strong>Estado:</strong> @cita.EstadoCita</p>
                </div>
            }
        </div>
    }
    else
    {
        <span>No hay citas registradas en este consultorio</span>
    }
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.IdConsultorio">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
